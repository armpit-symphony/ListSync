# Copy to deploy/.env on the server. Never commit deploy/.env.
# Generate the key on the server: openssl rand -hex 32

SECRET_KEY=replace-with-openssl-rand-hex-32
CORS_ORIGINS=https://listsync.sparkpitlabs.com
DB_NAME=shopping_app
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Leave empty so the browser calls /api on the same origin.
REACT_APP_BACKEND_URL=

# Used by reset emails and by `python -m tools.reset_link`. Invite links use the browser origin.
PUBLIC_ORIGIN=https://listsync.sparkpitlabs.com

# Optional SMTP. Leave SMTP_HOST empty and forgot-password still returns the same
# generic sentence. It does not include a reset link. An operator can print one with
# the reset_link command in docs/DEPLOY.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@listsync.sparkpitlabs.com
