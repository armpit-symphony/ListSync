# Copy to deploy/.env on the server. Never commit deploy/.env.
# Generate the key on the server: openssl rand -hex 32

SECRET_KEY=replace-with-openssl-rand-hex-32
CORS_ORIGINS=https://listsync.sparkpitlabs.com
DB_NAME=shopping_app
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Leave empty so the browser calls /api on the same origin.
REACT_APP_BACKEND_URL=
